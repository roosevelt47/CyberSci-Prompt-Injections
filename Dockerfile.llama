# llama.cpp server, built from the llama-b10909 release vendored in this repo so every
# student runs the exact binary the lab was validated against.
#
# ubuntu:24.04 because llama-server needs glibc >= 2.34 and OpenSSL 3 (libssl.so.3 /
# libcrypto.so.3). It does not link libcurl -- this build downloads -hf models with
# llama.cpp's built-in HTTP client.
FROM ubuntu:24.04@sha256:224a1869083a311ef3f13648a154ba79832fbef6364d31493642ca03082da254

RUN apt-get update \
 && apt-get install -y --no-install-recommends ca-certificates curl libgomp1 \
 && rm -rf /var/lib/apt/lists/*

# The binaries find their sibling .so files via $ORIGIN RPATH, so copying the directory
# wholesale is enough -- no LD_LIBRARY_PATH needed.
WORKDIR /opt/llama
COPY llama-b10909/ /opt/llama/

# llama-b10909/ ships real symlinks for the versioned .so chain (libfoo.so.0 ->
# libfoo.so.0.N.N). Git on Windows (and on any host without symlink privilege) checks a
# symlink out as a tiny plain-text file containing the target path instead of a real
# symlink, which COPY then carries in verbatim -- the loader then fails with "file too
# short". Self-heal here, inside the Linux build, so host OS/privilege never matters:
# any small regular (non-symlink) file whose entire content is an existing sibling's name
# gets replaced with a real symlink to that sibling. A file that came through as a real
# symlink already (Linux/macOS hosts, or Windows with Developer Mode) is untouched.
RUN for f in /opt/llama/*; do \
      [ -f "$f" ] && [ ! -L "$f" ] || continue; \
      [ "$(stat -c%s "$f")" -lt 200 ] || continue; \
      tgt="$(cat "$f")"; \
      case "$tgt" in *[!A-Za-z0-9._-]*|"") continue ;; esac; \
      [ -e "/opt/llama/$tgt" ] && [ "$tgt" != "$(basename "$f")" ] || continue; \
      rm -f "$f" && ln -s "$tgt" "$f"; \
    done

# No ENTRYPOINT/CMD on purpose: the model and sampling flags live in docker-compose.yml
# where students can read them.
